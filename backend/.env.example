# Backend Environment Configuration

# Server
PORT=3001
NODE_ENV=development

# Database
# Example: postgres://username:password@localhost:5432/overengineered
DATABASE_URL=postgres://postgres:postgres@localhost:5432/overengineered

# Grok API
GROK_API_KEY=xai-your-api-key-here

# Embeddings API
EMBEDDING_PROVIDER=openai # or 'voyage', 'cohere', etc.
EMBEDDING_API_KEY=sk-your-embedding-key-here
